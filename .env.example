# Parlameme Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# ESCROW MODE
# =============================================================================
# mock    - In-memory testing (no blockchain)
# sepolia - Base Sepolia testnet
# base    - Base mainnet (production)
ESCROW_MODE=sepolia

# =============================================================================
# BASE SEPOLIA (Testnet)
# =============================================================================
# Deployed contract address
ESCROW_CONTRACT_SEPOLIA=0x5c3214cA4C9CEfD4f91df3e5aae5610148dCBC48

# Platform signer private key (for withdrawal signatures)
# WARNING: Keep this secret! Never commit to git!
PLATFORM_SIGNER_KEY=

# USDC on Base Sepolia (Circle's testnet USDC)
SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# =============================================================================
# BASE MAINNET (Production)
# =============================================================================
# Deploy via: cd contracts && ./deploy-sepolia.sh v1 (change network to mainnet)
ESCROW_CONTRACT_MAINNET=

# Platform signer for mainnet
MAINNET_PLATFORM_SIGNER_KEY=

# USDC on Base Mainnet
MAINNET_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# =============================================================================
# RPC ENDPOINTS
# =============================================================================
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# Optional WebSocket for event subscription (faster than polling)
BASE_SEPOLIA_WS=wss://sepolia.base.org
BASE_MAINNET_WS=wss://mainnet.base.org

# =============================================================================
# PostgreSQL + Directus
# =============================================================================
# Leave PG_DSN empty to disable PostgreSQL sync (JSON-only mode)
PG_DSN=postgresql://parlameme:parlameme-dev@localhost:5432/parlameme
PG_PASSWORD=parlameme-dev
PG_PORT=5432

# Directus
DIRECTUS_SECRET=change-me-in-production-256bit-random
DIRECTUS_ADMIN_EMAIL=admin@parlameme.io
DIRECTUS_ADMIN_PASSWORD=parlameme-admin
DIRECTUS_PORT=8055

# =============================================================================
# Data Directory
# =============================================================================
# DATA_DIR=./data

# =============================================================================
# SERVER
# =============================================================================
PORT=3000
HOST=0.0.0.0
